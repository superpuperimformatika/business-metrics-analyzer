


@startuml
title UML-диаграмма компонентов Business Metrics Analyzer

top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 45

package "Presentation (API)" #E8F1FF {
  [AuthController] as AC
  [SalesController] as SC
  [KpiController] as KC
  [ReportsController] as RC
}

package "Application (Service Layer)" #E9F5E9 {
  [AuthService] as AS
  [SalesImportService] as SIS
  [KpiService] as KS
  [ReportService] as RS
  [UserService] as US
}

package "Domain" #FFF3DD {
  [User] as U
  [Sale] as S
  [Kpi] as K
  [Report] as R
  [KpiStrategy] as STR
  [Validators] as V
}

package "Infrastructure" #F1E9FA {
  [JwtProvider] as JWT
  [SqlUserRepository] as UR
  [SqlSaleRepository] as SR
  [UnitOfWork] as UOW
  [ExcelReportGenerator] as ER
  [EmailNotifier] as EN
}

database "PostgreSQL" as DB
cloud "SMTP" as SMTP

AC --> AS
SC --> SIS
KC --> KS
RC --> RS

AS --> US
AS --> JWT
US --> UR

SIS --> V
SIS --> UOW
SIS --> SR

KS --> STR
KS --> SR

RS --> ER
RS --> EN

UR --> DB
SR --> DB
UOW --> DB
EN --> SMTP

@enduml
